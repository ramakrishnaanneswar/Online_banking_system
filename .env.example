# ─────────────────────────────────────────────────────────────
# Online Banking System — Environment Variables
# Copy this file to `.env` (or `server/.env`) and fill in values.
# On Vercel / Render, add the same keys in the Dashboard → Env Vars.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3100
NODE_ENV=production

# MongoDB (Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/online_banking?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend origin (used for CORS). Comma-separate multiple origins.
# For Vercel:  https://your-app.vercel.app
# For Render:  https://your-app.onrender.com
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Email / SMTP — used to send the real Password Reset OTP
# Gmail setup: https://support.google.com/accounts/answer/185833
# Enable 2-Step Verification, then create an "App Password".
# SMTP_USER = your Gmail address, SMTP_PASS = the 16-char App Password.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="SecureBank" <your-email@gmail.com>
